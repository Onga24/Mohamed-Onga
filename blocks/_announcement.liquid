{% stylesheet %}
.announcement-bar__content {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 1.5rem;
  width: 100%;
}

.announcement-bar__button {
  position: relative;
  z-index: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--button-bg, #f4e04d);
  color: var(--button-color, #000);
  padding: 0.8rem 1.35rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-decoration: none;
  white-space: nowrap;
  text-transform: uppercase;
  border: 2px solid #0d0d0d;
  line-height: 1;
  overflow: hidden;
  transition: color 0.45s ease, border-color 0.45s ease;
  order: 1;
}

.announcement-bar__button::before {
  content: '';
  position: absolute;
  inset: 0;
  background: #000;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.7s cubic-bezier(0.2, 1, 0.2, 1);
  z-index: -1;
}

.announcement-bar__button:hover::before,
.announcement-bar__button:focus-visible::before {
  transform: scaleX(1);
}

.announcement-bar__button .svg-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1rem;
  height: 1rem;
}

.announcement-bar__button .svg-wrapper svg {
  width: 100%;
  height: 100%;
}

.announcement-bar__slide {
  position: relative;
}

.announcement-bar__text {
  margin: 0;
  text-align: center;
  flex: 1 1 auto;
  width: 100%;
}

.announcement-bar__button:hover,
.announcement-bar__button:focus-visible {
  --button-bg: #000;
  --button-color: #f4e04d;
}

@media screen and (max-width: 749px) {
  .announcement-bar__content {
    justify-content: center;
    gap: 0.75rem;
    flex-direction: column;
  }

  .announcement-bar__button {
    width: min(100%, 22rem);
    max-width: 22rem;
    min-height: 3.25rem;
    margin-inline: auto;
    order: 1;
  }

  .announcement-bar__text {
    order: 2;
    width: 100%;
  }
}
{%endstylesheet%}